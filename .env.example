DEBUG=true
LOG_LEVEL=info

SYSTEM_HTTP_PORT=3003

# MCP — свой порт; токены пусты и OAuth выключен — без авторизации (локальная разработка)
MCP_PORT=5060
MCP_PATH=/mcp
MCP_AUTH_TOKEN=
MCP_EXTERNAL_TOKENS=

# OAuth для клиентов, подключающихся по адресу (коннекторы Claude): подключение разрешают ключом из
# MCP_EXTERNAL_TOKENS на странице согласия. MCP_PUBLIC_URL — адрес MCP для клиентов (путь — MCP_PATH),
# MCP_OAUTH_SECRET — ключ подписи client_id, ≥32 случайных символов
MCP_OAUTH_ENABLED=false
MCP_PUBLIC_URL=
MCP_OAUTH_SECRET=
MCP_OAUTH_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback,http://localhost,http://127.0.0.1
MCP_OAUTH_ACCESS_TTL=1h
MCP_OAUTH_REFRESH_TTL=720h

RULES_PATH=./conf.yml

#PG_DSN="postgres://user:password@localhost:5432/database?sslmode=disable"

# пусто — in-cluster; для локальной разработки путь к kubeconfig и контекст
#KUBECONFIG=/Users/me/.kube/config
#KUBE_CONTEXT=yc-zeon
CLUSTER_NAME=zeon

# GitHub: service.yaml из репозиториев; REGISTRY_TOKEN — доступ к ghcr.io (по умолчанию = GITHUB_TOKEN)
#GITHUB_TOKEN=
#REGISTRY_TOKEN=

# Источники телеметрии: пустой URL — источник выключен.
# Авторизация: *_TOKEN — bearer; basic-auth — через userinfo в URL (https://user:pass@host);
# *_ORG_ID — заголовок X-Scope-OrgID (мультитенантные Loki/Mimir/Cortex).
#PROMETHEUS_URL=http://prometheus:9090
#PROMETHEUS_TOKEN=
#PROMETHEUS_ORG_ID=
#LOKI_URL=http://loki:3100
#LOKI_TOKEN=
#LOKI_ORG_ID=
#ALERTMANAGER_URL=http://alertmanager:9093
#ALERTMANAGER_TOKEN=

INDEXER_ENABLED=true
INDEXER_INTERVAL=5m

# ruto-core (API-gateway): опубликованные маршруты; внутри кластера без авторизации
RUTO_URL=
